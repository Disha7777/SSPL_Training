<h2>Your Stay Preferences</h2>

<form method="post">
    <label>Who are you staying with?</label>
    <select name="StayType">
        <option value="Family">Family</option>
        <option value="Friends">Friends</option>
    </select>

    <label><input type="checkbox" name="HasPet" /> Bringing a Pet?</label>
    <label><input type="checkbox" name="WantsAC" /> AC Room</label>
    <label><input type="checkbox" name="WantsBreakfast" /> Breakfast</label>
    <label><input type="checkbox" name="WantsLunch" /> Lunch</label>

    <button type="submit">Continue</button>
</form>
